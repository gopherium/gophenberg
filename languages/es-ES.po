msgstr "Vaciar %s"

msgid "Closed"
msgstr "Cerrado"

msgid "Content"
msgstr "Contenido"

msgid "Content Types"
msgstr "Tipos de contenido"

msgid "Content nests at most %(max)d levels deep, and this item would sit deeper. Pick a parent closer to the top."
msgstr "El contenido se anida como mucho %(max)d niveles, y este elemento quedaría más abajo. Elige un superior más cercano al principio."

msgid "Could not create a draft."
msgstr "No se ha podido crear el borrador."

msgid "Could not delete that item."
msgid_plural "Could not delete every item."
msgstr[0] "No se ha podido borrar ese elemento."
msgstr[1] "No se han podido borrar todos los elementos."

msgid "Could not delete that post."
msgstr "No se ha podido borrar esa entrada."

msgid "Could not empty the trash."
msgstr "No se ha podido vaciar la papelera."

msgid "Could not load %s."
msgstr "No se ha podido cargar %s."

msgid "Could not load that post."
msgstr "No se ha podido cargar esa entrada."

msgid "Could not move every post to trash."
msgstr "No se han podido mover todas las entradas a la papelera."

msgid "Could not move that post to trash."
msgstr "No se ha podido mover esa entrada a la papelera."

msgid "Could not restore that post."
msgid_plural "Could not restore those posts."
msgstr[0] "No se ha podido restaurar esa entrada."
msgstr[1] "No se han podido restaurar esas entradas."

msgid "Could not save that post."
msgstr "No se ha podido guardar esa entrada."

