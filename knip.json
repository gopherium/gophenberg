{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreBinaries": ["cover", "lint"],
	"ignore": [
		".e2e-themes/**",
		".e2e-archive/**",
		"internal/themehost/testdata/**",
		"docs/**"
	],
	"ignoreIssues": {
		"**/dist/**": ["files"],
		"**/coverage/**": ["files"]
	},
	"workspaces": {
		"sdk/frontend": {
			"includeEntryExports": true
		},
		"test/theme": {
			"entry": ["src/theme.ts", "src/pages/**/*.astro"],
			"ignoreDependencies": ["@astrojs/node"]
		}
	}
}
