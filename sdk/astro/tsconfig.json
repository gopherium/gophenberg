{
	"extends": "astro/tsconfigs/base",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.astro.tsbuildinfo",
		"lib": ["ES2023"],
		"types": ["node"],
		"allowJs": false,
		"moduleDetection": "force",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["."]
}
