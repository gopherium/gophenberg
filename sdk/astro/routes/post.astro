---
import { theme } from 'virtual:gophenberg/theme'

import { GophenbergClient } from '../client.ts'
import { defaultPostType } from '../kit.ts'

export const prerender = false

const type = Astro.params.type ?? defaultPostType
const slug = Astro.params.slug ?? ''
const post = await new GophenbergClient().getPost(type, slug)

if (!post) {
	return Astro.rewrite('/404')
}

const Post = theme.layouts.Post
---

<Post post={post} blocks={theme.blocks} seo={theme.seo} />
