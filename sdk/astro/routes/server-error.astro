---
// SPDX-License-Identifier: Apache-2.0

import { theme } from 'virtual:gophenberg/theme'

export const prerender = false

if (!('error' in Astro.props)) {
	return Astro.rewrite('/404')
}

const ServerError = theme.layouts.ServerError
---

{
	ServerError ? (
		<ServerError seo={theme.seo} />
	) : (
		<theme.layouts.Base seo={theme.seo} title="Something went wrong">
			<h1>Something went wrong</h1>
			<p>This page could not be loaded. Try again in a moment.</p>
		</theme.layouts.Base>
	)
}
