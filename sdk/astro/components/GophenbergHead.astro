---
// SPDX-License-Identifier: Apache-2.0

import { siteAssetUrls } from '../assets.ts'
import { generator, generatorFor } from '../kit.ts'
import { siteProfile } from '../site.ts'

interface Props {
	title?: string
}

const { title } = Astro.props
const assets = siteAssetUrls()
const site = await siteProfile()
const servedBy = site ? generatorFor(site.gophenberg) : generator
---

<meta name="generator" content={servedBy} />
{title && <title>{title}</title>}
<link rel="icon" href={assets.favicon} />
<link rel="stylesheet" href={assets.blocks} />
<link rel="stylesheet" href={assets.presets} />
<link rel="alternate" type="application/rss+xml" href={assets.feed} />
