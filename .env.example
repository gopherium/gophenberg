# Gophenberg configuration. Copy to .env and fill in the values.
# Real environment variables take precedence over anything set here.
# Every command reads this file, not only serve, and every value is trimmed of surrounding spaces.

GOPHENBERG_DATABASE_URL=postgres://postgres:gophenberg@localhost:5435/postgres?sslmode=disable
# GOPHENBERG_ADDR=localhost:8081

# Name the public site carries in its chrome. Defaults to Gophenberg.
# GOPHENBERG_SITE_TITLE=Gophenberg

# GOPHENBERG_FEED_TITLE=Gophenberg
# GOPHENBERG_FEED_ITEMS=20

# Plugins share the site's database pool. Each plugin adds this many slots to the share,
# one slot for each statement, open result set or transaction, from 1 to 1000.
# GOPHENBERG_PLUGIN_DB_CONNS=4
# How long one plugin statement may run, its wait for a slot included.
# GOPHENBERG_PLUGIN_QUERY_TIMEOUT=5s
# How long one plugin transaction may stay open.
# GOPHENBERG_PLUGIN_TX_TIMEOUT=30s

# Comma-separated CIDR ranges of reverse proxies allowed to set X-Forwarded-* headers.
# Behind a TLS-terminating proxy this must list it, or public links are built as http.
# GOPHENBERG_TRUSTED_PROXIES=10.0.0.0/8

# The address people reach the site at. When set, a write sent to any other address is refused.
# GOPHENBERG_PUBLIC_URL=https://example.com

# Where themes are installed, one directory per theme. Admin uploads write here, so any mount
# has to stay writable. The image sets /themes and expects a volume there.
# GOPHENBERG_THEMES_DIR=/srv/gophenberg/themes

# Pins one theme, overriding the admin. Empty lets the admin choose which theme serves.
# GOPHENBERG_THEME=starter

# Where uploaded media is stored, under year and month directories. Uploads write here and the
# public site serves the files from it, so any mount has to stay writable and has to survive a
# restart. Unset, the media library refuses every upload. The image sets /media and expects a
# volume there.
# GOPHENBERG_MEDIA_DIR=/srv/gophenberg/media

# The node binary a theme is served with. Defaults to node on PATH, and the image sets it to the
# node it ships at /nodejs/bin/node.
# GOPHENBERG_NODE_BIN=node

# The largest upload the media library takes, in megabytes.
# GOPHENBERG_MEDIA_UPLOAD_CAP_MB=128

# How long a media or theme upload has to arrive, in place of the HTTP read timeout.
# GOPHENBERG_UPLOAD_TIMEOUT=5m

# The largest definitions file an import takes, in kilobytes, up to 1024.
# GOPHENBERG_DEFINITIONS_IMPORT_CAP_KB=256

# How many containers a field may stand inside, from 1 to 1000. A flexible content layout counts
# as one.
# GOPHENBERG_FIELD_DEPTH=32

# The page sizes an admin list offers, from 2 to 6 of them, each once from the smallest up and none
# past the page cap, 10,20,50,100 when unset. The size a list opens at, one of those sizes, 20 when
# unset. The most items one admin list page carries, 100 when unset, a larger request answered at it.
# GOPHENBERG_LIST_PAGE_SIZES=10,20,50,100
# GOPHENBERG_LIST_PAGE_SIZE=20
# GOPHENBERG_LIST_PAGE_CAP=100

# How long a confirmation toast stays on screen, 6s when unset, in whole milliseconds from 1ms to
# 2147483647ms. How many characters of an item's name a toast shows before it cuts the name short,
# 45 when unset.
# GOPHENBERG_TOAST_DURATION=6s
# GOPHENBERG_TOAST_NAME_LENGTH=45

# The locale the admin writes dates, times and numbers in, whatever the interface language. A BCP 47
# tag that names a language, es-ES when unset, which writes 04/10/2026, 14:05 and 1.234,56.
# GOPHENBERG_FORMAT_LOCALE=es-ES

# How long a starting theme has to answer before it is given up on, and how many times it is tried
# again. Raise the timeout for a theme that boots slowly on modest hardware.
# GOPHENBERG_THEME_READY_TIMEOUT=30s
# GOPHENBERG_THEME_START_ATTEMPTS=5

# How long to wait before retrying a theme that will not start, doubling after each attempt up to
# the maximum.
# GOPHENBERG_THEME_BACKOFF=500ms
# GOPHENBERG_THEME_MAX_BACKOFF=30s

# How long a theme has to stop before it is killed, and how long a running theme has to start
# answering one request.
# GOPHENBERG_THEME_STOP_GRACE=3s
# GOPHENBERG_THEME_PROXY_TIMEOUT=10s

# How long a browser may keep a site asset or an uploaded file. Behind a proxy that sets its own
# Cache-Control the proxy wins for assets.
# GOPHENBERG_CACHE_ASSET_MAX_AGE=1h
# GOPHENBERG_CACHE_MEDIA_MAX_AGE=1h

# How long a shared cache may serve a public content answer, and how much longer it may serve the
# old one while fetching a fresh one. Write whole seconds, like 1h or 90s.
# GOPHENBERG_CACHE_CONTENT_SHARED_MAX_AGE=1m
# GOPHENBERG_CACHE_CONTENT_STALE_WHILE_REVALIDATE=5m

# How long a visitor has to send a request's headers and the whole request, and how long an idle
# connection waits for its next request.
# GOPHENBERG_HTTP_READ_HEADER_TIMEOUT=10s
# GOPHENBERG_HTTP_READ_TIMEOUT=30s
# GOPHENBERG_HTTP_IDLE_TIMEOUT=2m

# How long a stop gives running requests to finish, how long the ones cancelled after that get to
# end, and how long the plugins get to stop. Whatever stops the server must wait longer than these
# three and the theme stop grace added together. The plugin stop grace also bounds the plugins' stop
# after any other command that loads them, such as migrate.
# GOPHENBERG_SHUTDOWN_GRACE=10s
# GOPHENBERG_SHUTDOWN_CANCEL_GRACE=5s
# GOPHENBERG_SHUTDOWN_STOP_GRACE=5s

# How long an account command has to store the record of a change it applied, and how many records
# account:records lists when its -limit flag names no other.
# GOPHENBERG_COMMAND_RECORD_TIMEOUT=5s
# GOPHENBERG_COMMAND_RECORDS_LIMIT=50

# Credentials for the translation platform, read by make translations and make translations-retire.
# The scheduled workflow takes these from repository secrets instead.
# POEDITOR_API_TOKEN=
# POEDITOR_PROJECT_ID=
